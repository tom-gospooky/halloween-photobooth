# Google AI (Gemini) API for prompt generation
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# FAL AI for WAN 2.2 Turbo video generation
FAL_KEY=your_fal_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Master Prompt Configuration (optional - uses master.md by default)
MASTER_PROMPT=

# Raw API logging controls
# When 1, store raw request/response JSON for all API calls under logs/api
# When 0, only write high-level run.json timeline and omit per-call JSON files
LOG_RAW_API=1

# When 1, include binary payloads (e.g., base64, data URIs) in logged JSON
# When 0, replace large/binary fields with metadata (length/omitted flags)
LOG_INCLUDE_BINARIES=1

# Seedream input mode: auto | base64 | upload
# - auto: try base64 first, fallback to upload if rejected
# - base64: always send data URI (no upload fallback)
# - upload: always upload to FAL storage and send the URL
SEEDREAM_INPUT_MODE=auto
